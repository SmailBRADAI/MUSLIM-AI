{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SmailBRADAI/MUSLIM-AI/specs/001-hajj-umrah-companion/content-pack.schema.json",
  "title": "Journey content",
  "type": "object",
  "required": ["id", "type", "version", "stages"],
  "properties": {
    "id": { "type": "string" },
    "type": { "enum": ["umrah", "hajj-tamattu", "hajj-qiran", "hajj-ifrad"] },
    "version": { "type": "string" },
    "framework": { "const": "ibn-baz+ibn-uthaymeen", "description": "Rulings follow the fatwas of Ibn Baz and Ibn Al-Uthaymeen" },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "steps"],
        "properties": {
          "id": { "type": "string" },
          "order": { "type": "integer" },
          "day": { "type": "integer", "minimum": 8, "maximum": 13, "description": "Dhu al-Hijjah day, Hajj only" },
          "kind": {
            "enum": ["umrah", "arrival", "farewell"],
            "description": "Hajj only, for a stage that is not a single day: the Tamattu' Umrah, arrival in Makkah (Qiran, Ifrad), or the farewell"
          },
          "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
        }
      }
    }
  },
  "$defs": {
    "diagram": { "enum": ["tawaf", "sai", "miqat", "ihram-dress", "ihram-rules"] },
    "meta": {
      "type": "object",
      "required": ["source", "status", "version"],
      "properties": {
        "source": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "status": { "enum": ["draft", "in-review", "approved"] },
        "reviewer": { "type": "string", "description": "GitHub handle of a content reviewer role holder listed in content/reviewers.json" },
        "reviewedAt": { "type": "string", "format": "date" },
        "version": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "approved" } } },
      "then": { "required": ["reviewer", "reviewedAt"] }
    },
    "step": {
      "type": "object",
      "required": ["id", "order", "ruling", "place", "supplicationIds", "meta"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" },
        "order": { "type": "integer" },
        "ruling": { "enum": ["rukn", "wajib", "sunnah", "mustahabb"] },
        "rulingViews": {
          "type": "array",
          "description": "Present only when Ibn Baz and Ibn Al-Uthaymeen differ",
          "items": {
            "type": "object",
            "required": ["scholar", "ruling", "source"],
            "properties": {
              "scholar": { "enum": ["ibn-baz", "ibn-uthaymeen"] },
              "ruling": { "enum": ["rukn", "wajib", "sunnah", "mustahabb"] },
              "source": { "type": "string" }
            }
          }
        },
        "rulingNote": { "type": "string", "description": "Other schools' positions, informational only" },
        "supplicationIds": { "type": "array", "items": { "type": "string" } },
        "audioId": { "type": "string" },
        "diagram": {
          "description": "One illustration, or several shown in this order. The caption of the first is the text's diagramLabel; the labels inside and the later captions are the text's diagramItems",
          "oneOf": [
            { "$ref": "#/$defs/diagram" },
            { "type": "array", "items": { "$ref": "#/$defs/diagram" }, "minItems": 1, "uniqueItems": true }
          ]
        },
        "place": {
          "enum": ["miqat", "mataf", "maqam", "masa", "makkah", "mina", "jamarat", "muzdalifah", "arafah"],
          "description": "Where the step is performed, shown as the Guide's \"you are here\" visual: maqam is behind Maqam Ibrahim (the two rak'ahs after Tawaf), masa is between Safa and Marwah, makkah is elsewhere in Makkah"
        },
        "meta": { "$ref": "#/$defs/meta" }
      }
    }
  }
}
